<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ======================= -->
    <!-- SPRING PROPERTIES       -->
    <!-- ======================= -->

    <!-- Console Pattern -->
    <springProperty scope="context"
                    name="CONSOLE_PATTERN"
                    source="reyga.config.logging.console.pattern"
                    defaultValue="[%d{yyyy-MM-dd HH:mm:ss.SSS}] %X{x-starter-request-id} %-5level %logger{150} - %msg%n"/>

    <!-- File Pattern -->
    <springProperty scope="context"
                    name="FILE_PATTERN"
                    source="reyga.config.logging.file.pattern"
                    defaultValue="[%d{yyyy-MM-dd HH:mm:ss.SSS}] | %X{x-starter-request-id} | %-5level | %logger{150} | - %msg%n"/>

    <!-- Summary Pattern -->
    <springProperty scope="context"
                    name="SUMMARY_PATTERN"
                    source="reyga.config.logging.file.summary.pattern"
                    defaultValue="%d{yyyy-MM-dd HH:mm:ss.SSS} | %X{x-starter-request-id} | %-5level | %logger{150} | - %msg%n"/>

    <springProperty scope="context"
                    name="ENABLE_ROLLING"
                    source="reyga.config.logging.file.enable"
                    defaultValue="false"/>

    <springProperty scope="context"
                    name="ENABLE_SUMMARY_LOG"
                    source="reyga.config.logging.file.summary.enable"
                    defaultValue="true"/>

    <springProperty scope="context"
                    name="ROLLING_FILE"
                    source="reyga.config.logging.file.file-path"
                    defaultValue="logs/"/>

    <springProperty scope="context"
                    name="ROLLING_FILE_NAME"
                    source="reyga.config.logging.file.file-name"
                    defaultValue="%d{dd-MM-yyyy}.app.log.%i.gz"/>

    <springProperty scope="context"
                    name="ROLLING_ACTIVE_FILE_NAME"
                    source="reyga.config.logging.file.active-file-name"
                    defaultValue="application.log"/>

    <springProperty scope="context"
                    name="ROLLING_SUMMARY_NAME"
                    source="reyga.config.logging.file.summary.summary-file-name"
                    defaultValue="monitoring/%d{dd-MM-yyyy}.summary.log.%i.gz"/>

    <springProperty scope="context"
                    name="ROLLING_SUMMARY_ACTIVE_FILE_NAME"
                    source="reyga.config.logging.file.summary.summary-active-file-name"
                    defaultValue="monitoring/summary.log"/>

    <springProperty scope="context"
                    name="MAX_HISTORY"
                    source="reyga.config.logging.file.max-history"
                    defaultValue="30"/>

    <springProperty scope="context"
                    name="MAX_FILE_SIZE"
                    source="reyga.config.logging.file.max-file-size"
                    defaultValue="20MB"/>

    <springProperty scope="context"
                    name="CLEAN_HISTORY_ON_START"
                    source="reyga.config.logging.file.clean-history-on-start"
                    defaultValue="false"/>

    <springProperty scope="context"
                    name="SUMMARY_CLEAN_HISTORY_ON_START"
                    source="reyga.config.logging.file.summary.summary-clean-history-on-start"
                    defaultValue="false"/>

    <!-- ======================= -->
    <!-- APPENDERS               -->
    <!-- ======================= -->

    <!-- Console Appender -->
    <appender name="CONSOLE_LOG" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="reyga.starter.foundation.logging.filter.ConsoleLogFilter"/>
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Rolling File Appender -->
    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>ENABLE_ROLLING</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <appender name="ROLLING_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${ROLLING_FILE}${ROLLING_ACTIVE_FILE_NAME}</file>
                <filter class="reyga.starter.foundation.logging.filter.RollingLogFilter"/>
                <encoder>
                    <pattern>${FILE_PATTERN}</pattern>
                </encoder>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${ROLLING_FILE}${ROLLING_FILE_NAME}</fileNamePattern>
                    <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                    <maxHistory>${MAX_HISTORY}</maxHistory>
                    <cleanHistoryOnStart>${CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                </rollingPolicy>
            </appender>
        </then>
    </if>

    <!-- Summary Log Appender -->
    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>ENABLE_SUMMARY_LOG</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <appender name="SUMMARY_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${ROLLING_FILE}${ROLLING_SUMMARY_ACTIVE_FILE_NAME}</file>
                <!-- Filter log AFTER_COMPLETION -->
                <filter class="reyga.starter.foundation.logging.filter.SummaryLogFilter"/>
                <encoder>
                    <pattern>${SUMMARY_PATTERN}</pattern>
                </encoder>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${ROLLING_FILE}${ROLLING_SUMMARY_NAME}</fileNamePattern>
                    <maxFileSize>${MAX_FILE_SIZE}</maxFileSize>
                    <maxHistory>${MAX_HISTORY}</maxHistory>
                    <cleanHistoryOnStart>${SUMMARY_CLEAN_HISTORY_ON_START}</cleanHistoryOnStart>
                </rollingPolicy>
            </appender>
        </then>
    </if>

    <!-- ======================= -->
    <!-- ROOT LOGGER             -->
    <!-- ======================= -->

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE_LOG"/>
    </root>

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>ENABLE_ROLLING</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <logger name="ROOT" level="INFO" additivity="true">
                <appender-ref ref="ROLLING_LOG"/>
            </logger>
        </then>
    </if>

    <condition class="ch.qos.logback.core.boolex.PropertyEqualityCondition">
        <key>ENABLE_SUMMARY_LOG</key>
        <value>true</value>
    </condition>
    <if>
        <then>
            <logger name="ROOT" level="INFO" additivity="true">
                <appender-ref ref="SUMMARY_LOG"/>
            </logger>
        </then>
    </if>


</configuration>
